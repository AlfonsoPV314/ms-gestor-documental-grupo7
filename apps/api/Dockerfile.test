FROM node:22.22.0-alpine3.23@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS node
FROM golang:1.26.11-alpine3.23@sha256:23f198931d4bd83b4f5a613bd75656257ae8bf832dcbc2db80e1050b5219ca2a
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/lib/libstdc++.so.* /usr/lib/
COPY --from=node /usr/lib/libgcc_s.so.1 /usr/lib/
WORKDIR /src
ENV GOTOOLCHAIN=go1.26.11
USER 65532:65532
CMD ["node", "scripts/e2e.mjs"]


